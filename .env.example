# SENTINEL Environment Configuration
PROJECT_NAME="SENTINEL Operational Intelligence"
API_V1_STR="/api/v1"
DEBUG=true

# Database (Default SQLite for prototype; compatible with PostgreSQL via SQLAlchemy)
DATABASE_URL="sqlite:///./sentinel.db"

# Campus Assumptions & Economics
DEFAULT_CAMPUS_NAME="DEMO CAMPUS"
ENERGY_TARIFF_PER_KWH=12.0 # In local currency units (e.g. ₹12 / kWh or $0.15 / kWh)
EMISSION_FACTOR_KG_CO2_PER_KWH=0.82 # Grid emission intensity

# Simulator Configuration
SIMULATOR_INTERVAL_SECONDS=5.0
SIMULATOR_AUTO_START=false

# Optional Natural Language Query (TokenRouter / Kimi API)
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL="kimi-latest"
